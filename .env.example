# App
PORT=3000
JWT_SECRET=
JWT_EXPIRES_IN=8h

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_NAME=bnpt_ipdr
DB_CONNECTION_LIMIT=10

# Redis (vector filter cache)
REDIS_HOST=
REDIS_PORT=6379

# Kafka (ingestion)
KAFKA_BROKER=
KAFKA_TOPIC=telco.ipdr.stream.v1
KAFKA_GROUP_ID=ipdr-filtering-group

# SFTP (dispatch)
SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=
SFTP_PASSWORD=
SFTP_REMOTE_PATH=/ipdr/inbound
